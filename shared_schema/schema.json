{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QChainSharedSchemas",
  "definitions": {
    "Finding": {
      "type": "object",
      "required": [
        "rule_id",
        "file",
        "line",
        "algorithm",
        "context",
        "quantum_risk",
        "confidence",
        "snippet",
        "description"
      ],
      "properties": {
        "rule_id": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "column": { "type": "integer" },
        "algorithm": { "type": "string" },
        "context": {
          "type": "string",
          "enum": ["key_generation", "signing", "verification", "key_exchange", "storage", "hash_and_sign"]
        },
        "quantum_risk": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "snippet": { "type": "string" },
        "description": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    },
    "ScanSummary": {
      "type": "object",
      "required": ["total_files_scanned", "total_findings", "critical_count", "high_count", "medium_count", "low_count"],
      "properties": {
        "total_files_scanned": { "type": "integer" },
        "total_findings": { "type": "integer" },
        "critical_count": { "type": "integer" },
        "high_count": { "type": "integer" },
        "medium_count": { "type": "integer" },
        "low_count": { "type": "integer" }
      }
    },
    "Report": {
      "type": "object",
      "required": [
        "report_id",
        "timestamp",
        "target_app",
        "summary",
        "findings",
        "tool_versions"
      ],
      "properties": {
        "report_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "target_app": { "type": "string" },
        "summary": { "$ref": "#/definitions/ScanSummary" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/Finding" }
        },
        "benchmarks": { "type": "object" },
        "verification_matrix": { "type": "object" },
        "tool_versions": {
          "type": "object",
          "properties": {
            "scanner_version": { "type": "string" },
            "contract_version": { "type": "string" },
            "node_version": { "type": "string" },
            "python_version": { "type": "string" }
          }
        }
      }
    },
    "AnchorRecord": {
      "type": "object",
      "required": ["report_hash", "submitter", "timestamp", "block_number", "transaction_hash"],
      "properties": {
        "report_hash": { "type": "string" },
        "submitter": { "type": "string" },
        "timestamp": { "type": "integer" },
        "block_number": { "type": "integer" },
        "transaction_hash": { "type": "string" }
      }
    }
  }
}
